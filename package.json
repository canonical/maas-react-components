{
  "name": "@canonical/maas-react-components",
  "description": "React components for use in MAAS UI projects.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canonical/maas-react-components.git"
  },
  "bugs": {
    "url": "https://github.com/canonical/maas-react-components/issues"
  },
  "homepage": "https://github.com/canonical/maas-react-components#readme",
  "main": "./dist/@canonical/maas-react-components.es.js",
  "module": "./dist/@canonical/maas-react-components.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/@canonical/maas-react-components.es.js",
      "default": "./dist/@canonical/maas-react-components.es.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.es.js",
      "default": "./dist/testing/index.es.js"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc && vite build",
    "build:run": "npm run build",
    "build:watch": "tsc && vite build --watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts,.tsx src && tsc --noEmit && stylelint src/**/*.scss",
    "lint:run": "npm run lint",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts,.tsx --fix src && stylelint src/**/*.scss --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,md,json}' --config ./.prettierrc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "semantic-release": "semantic-release",
    "semantic-release-dry-run": "semantic-release --dry-run --no-ci",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "create-component": "plop component"
  },
  "devDependencies": {
    "@canonical/summon": "^0.44.0",
    "@canonical/summon-application": "^0.44.0",
    "@canonical/summon-component": "^0.44.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@remix-run/router": "^1.23.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/react": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tanstack/react-query": "^5.106.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^26.1.0",
    "msw": "^3.0.3",
    "plop": "^4.0.0",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.1",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.5",
    "storybook-addon-tags": "^0.0.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@canonical/react-components": {
      "@types/react": "$@types/react",
      "@types/react-dom": "$@types/react-dom"
    }
  },
  "peerDependencies": {
    "@canonical/ds-assets": "^0.37.0 || ^0.45.0",
    "@canonical/react-components": "^4.5.0",
    "@canonical/react-ds-global": "^0.37.0",
    "@canonical/react-ds-global-form": "^0.37.0",
    "@canonical/styles": "^0.37.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-table": "^8.15.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "classnames": "^2.3.2",
    "msw": "^3.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-router": ">=6.0.0",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
