{
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "vitest-setup.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./.storybook/**/*.ts"
  ]
}
